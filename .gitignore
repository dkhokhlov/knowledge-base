# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# uv venv (provisioned by `make ci` = uv sync; not committed -- reprovision from
# pyproject.toml + uv.lock). uv.lock IS committed (the pinned resolution).
.venv/

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store

# Local logs / scratch
*.log

# Claude Code local index cache
.claude/
.codebase-index/

# Persistent data bind-mount tree (moved to RAID + symlinked back by the user)
/data/

# Deployment config + secrets are all gitignored. .env.template is the tracked
# template (no secrets; OLLAMA_HOST + KB_HOST are commented out — set them in
# the shell env, or uncomment + set in .env). `make bootstrap` copies it to .env.
# .env holds the live config incl. OLLAMA_BASE_URL (host-specific).
# .env.local holds WEBUI_SECRET_KEY and GRAPHITI_API_TOKEN (generated).
.env
.env.local
.env.*.local

.opencode/index/

# Legacy ./gdrive layout (pre-./root): keep the old corpus + gdrive-exclude.conf
# ignored so PII is never accidentally committed. No-ops once the corpus lives
# under ./root/gdrive (ignored via /root/* above).
/gdrive/
/gdrive-exclude.conf

# KB source root: each top-level non-dot subdir of ./root/ is one KB (named after
# the subdir). Ignore ./root CONTENTS but keep the directory itself tracked via
# the committed .tests fixture set (so the compose ./root:/kb-source:ro bind-mount
# target exists in a fresh checkout; rclone/rsync populate it at runtime). .tests
# is a dot-dir so the generic walk skips it; the fixture test indexes it via
# /index?dir=.tests.
/root/*
!/root/.tests/
!/root/.tests/**

# rclone sync --backup-dir retention (deleted/overwritten Drive files moved here
# so the gateway does not re-index them; outside ./root on purpose). `make clean` wipes it.
/.gdrive-backup/

# clean-all config retention: dated backups of .env + .env.local made before
# wipe (recovery net). `make clean-backup` clears it.
/.config-backup/

# Isolated e2e clones (make test-e2e-iso, tests/test_12_kb_check.sh, ...):
# throwaway copies of the repo run under a separate compose project (kb-e2e,
# kb-kbcheck, ...) so the live stack keeps running. On a successful run the
# wrapper removes them; `make clean-test` (or e2e_down) tears down the isolated
# stack + removes them after a failed run. All clones live under ONE parent:
# .test-env/<stamp>-<name>/ (stamp-first so `ls .test-env/` shows every run in
# time order across test types). `/.test-*/` matches the parent + any straggler.
/.test-*/

# make kb-finalize / gdrive-sync-finalize host-side serialize lock (flock on fd
# 9; the file is NOT auto-removed on exit, so a crashed/stale holder lingers).
# Gitignored so a stale lock does not dirty the tree (e2e_isolate rejects a
# dirty source tree). Remove manually only if no finalize is running.
/.kb-finalize.lock

# make backup DR snapshots: dated tarballs of ./data + .env + .env.local
# (full stack state). Operator copies these off-host for disaster recovery.
/.backups/

# Unified KB deny-list (per-directory .kb-ignore, gitignore-style: rules relative
# to each file's own dir; ./root/.kb-ignore holds globals). LOCAL ONLY — may
# contain Drive file paths (business-sensitive, PII). Do NOT commit. Both
# gdrive-sync (rclone download stage) and the gateway walk (index stage) read the
# ancestor chain at runtime. /root/* above already ignores these; the line below
# documents intent. The format is documented in docs/operations.md.
/root/.kb-ignore
