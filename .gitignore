# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store

# Local logs / scratch
*.log

# Claude Code local index cache
.claude/
.codebase-index/

# Persistent data bind-mount tree (moved to RAID + symlinked back by the user)
/data/

# Deployment config + secrets are all gitignored. .env.example is the tracked
# template (no secrets; <ollama-host> placeholder). `make bootstrap` copies it
# to .env. .env holds the live config incl. OLLAMA_BASE_URL (host-specific).
# .env.local holds WEBUI_SECRET_KEY and GRAPHITI_API_TOKEN (generated).
.env
.env.local
.env.*.local

.opencode/index/

# Local Google Drive export tree.
# Ignore gdrive/ CONTENTS but keep the directory itself tracked via .gitkeep
# (so the compose bind-mount target exists in a fresh checkout; rclone and
# oikb populate it at runtime). .sync-reports/ under it is ignored too.
/gdrive/*
!/gdrive/.gitkeep

# rclone sync --backup-dir retention (deleted/overwritten Drive files moved here
# so oikb does not re-index them; outside ./gdrive on purpose). `make clean` wipes it.
/.gdrive-backup/

# rclone exclude list for gdrive-sync (INI format: [<drive name>] sections of
# per-drive patterns + a [*] section of all-drives patterns like *.pyc). LOCAL
# ONLY — contains Drive file paths (business-sensitive, PII). Do NOT commit.
# gdrive-sync reads it at runtime and converts it to rclone --exclude-from.
# The tracked gdrive-exclude.conf.example documents the format.
/gdrive-exclude.conf
