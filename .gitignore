# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store

# Local logs / scratch
*.log

# Claude Code local index cache
.claude/
.codebase-index/

# Persistent data bind-mount tree (moved to RAID + symlinked back by the user)
/data/

# Deployment config + secrets are all gitignored. .env.template is the tracked
# template (no secrets; OLLAMA_HOST + KB_HOST are commented out — set them in
# the shell env, or uncomment + set in .env). `make bootstrap` copies it to .env.
# .env holds the live config incl. OLLAMA_BASE_URL (host-specific).
# .env.local holds WEBUI_SECRET_KEY and GRAPHITI_API_TOKEN (generated).
.env
.env.local
.env.*.local

.opencode/index/

# Local Google Drive export tree.
# Ignore gdrive/ CONTENTS but keep the directory itself tracked via .gitkeep
# (so the compose bind-mount target exists in a fresh checkout; rclone and
# oikb populate it at runtime). .sync-reports/ under it is ignored too.
/gdrive/*
!/gdrive/.gitkeep
# Committed api-gateway /index fixture set: a dot-dir so the full gdrive walk
# skips it (no contamination of the real gdrive KB); the fixture test indexes
# it via /index?path=.tests. gdrive-sync never touches it (per-drive sync
# targets are siblings under ./gdrive/<drive>/, not the root).
!/gdrive/.tests/
!/gdrive/.tests/**

# rclone sync --backup-dir retention (deleted/overwritten Drive files moved here
# so oikb does not re-index them; outside ./gdrive on purpose). `make clean` wipes it.
/.gdrive-backup/

# clean-all config retention: dated backups of .env + .env.local made before
# wipe (recovery net). `make clean-backup` clears it.
/.config-backup/

# Isolated e2e clones (make test-e2e-iso, tests/test_12_kb_check.sh, ...):
# throwaway copies of the repo run under a separate compose project (kb-e2e,
# kb-kbcheck, ...) so the live stack keeps running. On a successful run the
# wrapper removes them; `make clean-test` (or e2e_down) tears down the isolated
# stack + removes them after a failed run. Generic: any .test-*/ clone.
/.test-*/

# make backup DR snapshots: dated tarballs of ./data + .env + .env.local
# (full stack state). Operator copies these off-host for disaster recovery.
/.backups/

# rclone exclude list for gdrive-sync (INI format: [<drive name>] sections of
# per-drive patterns + a [*] section of all-drives patterns like *.pyc). LOCAL
# ONLY — contains Drive file paths (business-sensitive, PII). Do NOT commit.
# gdrive-sync reads it at runtime and converts it to rclone --exclude-from.
# The tracked gdrive-exclude.conf.example documents the format.
/gdrive-exclude.conf
