#!/usr/bin/env bash

set -Eeuo pipefail

usage() {
    cat <<'EOF'
Usage: gdrive-sync [options]

Download all accessible Google Drive shared drives into a local directory.

Options:
  -r, --remote NAME       rclone remote name (default: gdrive)
  -d, --destination DIR  local destination (default: ./gdrive)
      --dry-run           show transfers without downloading files
      --index-all         force a full re-index of every file (default:
                          incremental: only new/changed files are indexed)
      --retry-pending     also re-trigger files still pending (stalled in
                          extraction/OCR). Default re-triggers only failed
                          files; use this after a drain stalls (a pending file
                          stuck in OCR). Interrupts in-flight OCR, so it is not
                          the default.
      --path RELPATH      index only a subpath of ./gdrive (a dir or a single
                          file; relative to the gdrive root). The reconcile is a
                          FULL reconcile of that subpath: use a KB whose whole
                          scope is that path (a dedicated/subpath KB). On the
                          shared gdrive KB this deletes every KB file outside
                          the subpath, so do not use it there.
  -h, --help              show this help

The destination contains one directory per shared drive. The command uses
rclone sync, so files removed from Drive are deleted from the destination
(delta sync). Deleted/overwritten files are moved into a dated backup dir
(.<destination>-backup/<UTC-ISO>/) as a recovery net, NOT deleted in place —
so a bad/empty mount is recoverable from the backup dir (`make clean` clears it).

After the sync (unless --dry-run), the synced tree is reconciled into the OWUI
"gdrive" knowledge base via api-gateway POST /index (stateless sync/diff against
the live KB; the gateway holds the admin key). Default is incremental (only
new/changed files uploaded + extracted); --index-all drains + re-uploads every
file. Fail-fast: a non-2xx /index response or ok=false aborts after the report.
Skipped silently if OPENWEBUI_ADMIN_API_KEY is unset (run: make api-keys), or if the
"gdrive" KB cannot be resolved by name (run: make kb-bootstrap KB=gdrive).

Fail-fast: ANY transfer error aborts the run immediately (the report is still
written with the failing files + rclone reasons). A per-drive empty-source guard
refuses to sync a drive whose remote listing is empty (an empty remote would make
the deletion reconcile back up every local file in that drive).

Concurrency: a hidden <destination>/.sync.lock (holder PID) prevents two runs
from racing on the same destination; a stale lock whose PID is no longer alive
is retaken. Aborts with exit 1 if another run is in progress.

Two-pass download + own deletion reconcile. Pass 1: rclone lsf -R --files-only
enumerates the per-drive remote file list. The shared .kb-ignore matcher
(scripts/kb_ignore.py; gitignore-style, ancestor-chain, `!` negation) filters it
into the allowed list -- the same .kb-ignore the gateway index walk honors, so
the download + index stages agree. Pass 2: rclone copy --files-from <allowed>
downloads only allowed files (skips unchanged via mtime/size; --backup-dir backs
up overwrites). rclone copy does NOT delete, so this script owns deletion: a local
file not in the remote listing (removed from Drive) is moved to --backup-dir,
unless PROTECTED (a dot-name; a .sync-reports file; or denied by .kb-ignore --
denied files persist locally, same as the old sync --exclude-from). Per-drive
.kb-ignore files list non-downloadable files (Drive-admin download-forbidden 403,
dangling shortcuts); add one when a sync fails fast on a NEW non-downloadable file
and re-run. Transient errors (network/5xx) are NOT excluded -- those fail fast by
design.

A sync report is written to <destination>/.sync-reports/sync-<UTC-ISO>.report
containing the per-drive + total summary, a "Files changed" breakdown
(COPY / UPDATE / DELETE, per file with drive prefix; DELETE from the reconcile),
a "Files excluded" section (remote files denied by .kb-ignore, re-derived as
remote_listing - allowed), a "Duplicates ignored" section (Drive files rclone
skipped because another file shares the same path -- Drive permits duplicate
names), and a "Files not downloaded" section (failing paths + rclone reasons).
EOF
}

remote="gdrive"
destination="./root/gdrive"
dry_run=0
index_all=0
retry_pending=0
path=""

# KB-indexable document filter — MUST match DEFAULT_ALLOW in gateway/app.py
# (the gdrive index documents-only set: docx,pdf,pptx,xlsx,txt,md,html,json,log,
# tex). Used to count local files the KB will index (the indexable set), distinct from the
# raw local count (all extensions). Case-insensitive (-iname) matches the
# gateway's ext.lower(); -not -path '*/.*' prunes dot-names like walk_source
# (gateway/app.py:806). KB_ALLOW env override is NOT honored here (the host sync
# runs without the gateway container env) — if you override KB_ALLOW, update
# this list too.
indexable_filter=( -not -path '*/.*' \(
    -iname '*.docx' -o
    -iname '*.pdf'  -o
    -iname '*.pptx' -o
    -iname '*.xlsx' -o
    -iname '*.txt'  -o
    -iname '*.md'   -o
    -iname '*.html' -o
    -iname '*.json' -o
    -iname '*.log'  -o
    -iname '*.tex'
\) )
# Same document allowlist as a grep -Ei regex, applied to the rclone remote
# listing (each line is a path ending in the filename, so "\.ext$" matches the
# file extension). Yields the PRE-EXCLUSION "allowed" count — Drive files that
# match the indexable extensions before gdrive-exclude.conf removes any. Mirrors
# DEFAULT_ALLOW (gateway/app.py:750) and indexable_filter above — keep in sync.
allowed_re='\.(docx|pdf|pptx|xlsx|txt|md|html|json|log|tex)$'

while (($# > 0)); do
    case "$1" in
        -r|--remote)
            (($# >= 2)) || { echo "error: --remote needs a value" >&2; exit 2; }
            remote="$2"
            shift 2
            ;;
        -d|--destination)
            (($# >= 2)) || { echo "error: --destination needs a value" >&2; exit 2; }
            destination="$2"
            shift 2
            ;;
        --path)
            (($# >= 2)) || { echo "error: --path needs a value" >&2; exit 2; }
            path="$2"
            shift 2
            ;;
        --dry-run)
            dry_run=1
            shift
            ;;
        --index-all)
            index_all=1
            shift
            ;;
        --retry-pending)
            retry_pending=1
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "error: unknown option: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

command -v rclone >/dev/null 2>&1 || {
    echo "error: rclone is not installed or is not in PATH" >&2
    exit 127
}
command -v jq >/dev/null 2>&1 || {
    echo "error: jq is not installed or is not in PATH" >&2
    exit 127
}

drive_json=$(rclone backend --json drives "${remote}:") || {
    echo "error: cannot list shared drives through rclone remote '${remote}'" >&2
    exit 1
}

drive_count=$(jq 'length' <<<"$drive_json")
if [[ "$drive_count" == 0 ]]; then
    echo "error: no shared drives are visible through rclone remote '${remote}'" >&2
    exit 1
fi

mkdir -p -- "$destination"

# --- sync report setup ------------------------------------------------------
# rclone logs each failed transfer with its path + cause at INFO level; we parse
# that log after the run to list files that were NOT downloaded and why. The
# report lives under the (gitignored) destination in a hidden dir rclone never
# writes into (rclone sync targets per-drive subdirs, not the destination root).
reports_dir="$destination/.sync-reports"
mkdir -p -- "$reports_dir"
ts=$(date -u +%Y%m%dT%H%M%SZ)
report="$reports_dir/sync-${ts}.report"

# rclone sync --backup-dir retention: deleted/overwritten files are moved here
# (in their original hierarchy) instead of being deleted in place. MUST sit
# outside <destination> — api-gateway walks <destination> read-only and would
# index any backup file matching the gateway allowlist (*.pdf, *.docx, ...).
# Dated subdir per run so backups never overwrite each other. `make clean`
# wipes the whole .<destination>-backup tree.
dest_norm="${destination%/}"
backup_dir="$(cd "$(dirname "$dest_norm")" && pwd)/.$(basename "$dest_norm")-backup"
backup_root="$backup_dir/$ts"
temp_files=()
# Per-drive rclone logs are created in the loop (--log-file); the EXIT trap
# removes them all. Each drive's log is parsed right after its sync for
# COPY/UPDATE/DELETE + failures (paths are drive-relative, so the drive name is
# added at parse time).

# --- concurrency lock -------------------------------------------------------
# A hidden .sync.lock inside <destination> holds the holder's PID. Two
# gdrive-sync runs into the same destination would race on the per-drive dirs
# and the --backup-dir tree (rclone sync deletes to match source — a second
# run could delete the first run's in-flight files). Acquire before the sync
# loop; release on every exit path via the EXIT trap. A stale lock whose PID is
# no longer alive (crashed/killed holder) is retaken — `kill -0` is the
# liveness probe. PID reuse is a residual: a dead PID recycled to an unrelated
# live process would look alive and block (rare on a single-user host). The
# lock file has no gateway-allowlisted extension, so api-gateway does not index it.
# `lock_held` gates release so a contention abort (exit 1 before we acquire)
# does NOT delete the other holder's lock via the EXIT trap.
LOCK="$dest_norm/.sync.lock"
lock_held=0
# shellcheck disable=SC2317 # invoked via the EXIT trap (cleanup), not directly
release_lock() {
    if (( lock_held )); then
        rm -f -- "$LOCK" 2>/dev/null || true
    fi
}
acquire_lock() {
    if [[ -f "$LOCK" ]]; then
        local old_pid
        old_pid=$(cat -- "$LOCK" 2>/dev/null || true)
        if [[ "$old_pid" =~ ^[0-9]+$ ]] && kill -0 "$old_pid" 2>/dev/null; then
            printf 'FAIL: another gdrive-sync is already running on %s (pid %s, lock %s) — aborting.\n' \
                "$destination" "$old_pid" "$LOCK" >&2
            exit 1   # lock_held is still 0 → release_lock (EXIT trap) is a no-op
        fi
        # Stale lock (holder PID no longer alive) — retake.
        printf 'stale lock %s (pid %s not alive) — retaking\n' "$LOCK" "$old_pid" >&2
        rm -f -- "$LOCK"
    fi
    printf '%s\n' "$$" > "$LOCK"
    lock_held=1
}
# shellcheck disable=SC2317 # invoked via the EXIT trap below
cleanup() {
    if (( ${#temp_files[@]} > 0 )); then
        rm -f -- "${temp_files[@]}" 2>/dev/null || true
    fi
    release_lock
}
trap cleanup EXIT
acquire_lock

# summary accumulates the report-worthy lines (also printed to stdout).
summary=""
emit() { printf '%s\n' "$*"; summary+="$*"$'\n'; }

# Owner-only perms (files 600, dirs 700) on the synced tree + backup retention.
# Drive content is business-sensitive; rclone v1.60 has no --umask, so normalize
# after the sync. api-gateway reads ./gdrive read-only as the host owner uid
# (HOST_UID in .env), so owner-only is readable by the container. Skip
# under --dry-run (no files are created). Run on every exit path (success +
# fail-fast).
normalize_perms() {
    (( dry_run )) && return 0
    find "$destination" -type d -exec chmod 700 {} + 2>/dev/null || true
    find "$destination" -type f -exec chmod 600 {} + 2>/dev/null || true
    if [[ -d "$backup_dir" ]]; then
        find "$backup_dir" -type d -exec chmod 700 {} + 2>/dev/null || true
        find "$backup_dir" -type f -exec chmod 600 {} + 2>/dev/null || true
    fi
}

# Parse this drive's rclone log into the global $changes accumulator. Each line
# is TAG<TAB><drive>/<path> for COPY/UPDATE/DELETE/EXCLUDE/DUP, or
# FAIL<TAB><drive>/<path><TAB><reason> for transfer failures. rclone log paths
# are relative to the drive root, so the drive name is prepended here. Filenames
# may contain ": " (e.g. "Report: Q4 review - ..."), so the
# path/message split anchors on the fixed rclone message, not the first ": ".
# COPY/UPDATE/DELETE: with rclone sync --backup-dir (always on here) an
# overwritten file logs "Moved ..." (old copy to backup) then "Copied (new)"
# (new copy in), and a deleted file logs "Moved ..." then "Moved into backup
# dir" — NOT "Copied (replaced existing)" / "Deleted". So a "Moved" line is
# PENDING: resolved to UPDATE when a "Copied (new)" follows for the same path
# (old moved to backup, new replaced it), else DELETE at end of log (moved to
# backup, no replacement). The old verbs still match as a fallback.
# DUP: rclone logs "Duplicate object found in source - ignoring" when Drive
# holds two files at the same path (Drive permits duplicate names); it syncs
# one and ignores the rest. Counted so the report's remote/local/excluded/dups
# table reconciles (remote counts every object; local only the one rclone keeps).
# Failures are deduped by path keeping the LAST reason (rclone retries repeat a
# path). Excludes are NOT deduped (same-path duplicates each log once). The
# local dest side never logs "Excluded", so no source+dest double-count risk.
parse_drive_log() {
    local parsed
    parsed=$(python3 - "$drive_log" "$safe_name" <<'PY'
import re, sys
log, drive = sys.argv[1], sys.argv[2]
PREFIX = re.compile(r'^\d{4}/\d{2}/\d{2} \d{2}:\d{2}:\d{2} \w+\s*: ')
NEW  = re.compile(r'^(.+): Copied \(new\)$')
REPL = re.compile(r'^(.+): Copied \(replaced existing\)$')   # overwrite, no --backup-dir
DELO = re.compile(r'^(.+): Deleted$')                       # delete, no --backup-dir
# With rclone sync --backup-dir (always on here), an overwritten file is first
# moved out to the backup dir then the new version copied in, and a deleted file
# is moved to the backup dir — so rclone logs "Moved ..." verbs instead of
# "Copied (replaced existing)" / "Deleted". A "Moved" line is therefore PENDING:
# resolve it to UPDATE if a fresh "Copied (new)" follows for the same path (the
# old copy went to backup, a new one replaced it), else to DELETE at end of log
# (the file moved to backup with no replacement). Robust to the verb text varying
# by backend (local "Moved (server-side)", Drive variants, ...): any "Moved"
# line is pending, and the old verbs still match as a fallback.
MOVED = re.compile(r'^(.+): Moved')
FAIL = re.compile(r'^(.+): Failed to copy: (.+)$')
EXC  = re.compile(r'^(.+): Excluded$')
DUP  = re.compile(r'^(.+): Duplicate object found in source - ignoring$')
out = []
fail = {}
excl = []
dup = []
moved = set()   # paths moved to backup dir, pending UPDATE-or-DELETE resolution
for ln in open(log, errors="replace"):
    if not PREFIX.match(ln):
        continue
    rest = PREFIX.sub("", ln.rstrip("\n"))
    m = NEW.match(rest)
    if m:
        p = m.group(1)
        if p in moved:               # old copy moved to backup, new replaces it
            out.append("UPDATE\t%s/%s" % (drive, p)); moved.discard(p)
        else:
            out.append("COPY\t%s/%s" % (drive, p))
        continue
    m = REPL.match(rest)
    if m:
        p = m.group(1); out.append("UPDATE\t%s/%s" % (drive, p)); moved.discard(p); continue
    m = DELO.match(rest)
    if m:
        p = m.group(1); out.append("DELETE\t%s/%s" % (drive, p)); moved.discard(p); continue
    m = MOVED.match(rest)
    if m:
        moved.add(m.group(1)); continue
    fm = FAIL.match(rest)
    if fm:
        path, reason = fm.group(1), fm.group(2)
        # rclone retry summaries ("Attempt 1/3", "There were N ...") are not
        # real paths — skip them. Matched on their numeric form so a real file
        # named "Failed invoice.pdf" / "There were wolves.pdf" is kept.
        if re.match(r'^(Attempt \d+/\d+|There were \d+ )', path):
            continue
        fail[path] = reason
        continue
    em = EXC.match(rest)
    if em:
        excl.append(em.group(1)); continue
    dm = DUP.match(rest)
    if dm:
        dup.append(dm.group(1)); continue
# End of log: a path moved to backup with no fresh copy = DELETE.
for p in sorted(moved):
    out.append("DELETE\t%s/%s" % (drive, p))
for p in sorted(fail):
    out.append("FAIL\t%s/%s\t%s" % (drive, p, fail[p]))
for p in sorted(excl):
    out.append("EXCLUDE\t%s/%s" % (drive, p))
for p in sorted(dup):
    out.append("DUP\t%s/%s" % (drive, p))
print("\n".join(out))
PY
)
    if [[ -n "$parsed" ]]; then
        changes+="$parsed"$'\n'
        # drive_excl_count / drive_dup_count are the ALLOWED-TYPED subsets, so the
        # table arithmetic holds: allowed - excluded - dups = indexable. Excludes
        # are further restricted to files truly removed (NOT leftovers on disk):
        # rclone does not delete excluded files, so a file excluded by
        # gdrive-exclude.conf but still on local is indexed anyway and must NOT be
        # subtracted. Dups are always subtracted (remote lists both copies; local
        # keeps one). Non-allowed-typed excludes/dups (.py/.csv/.sv/...) do not
        # touch the indexable count and are NOT in these columns (see the body's
        # "Files excluded" section for the full rclone exclude list).
        drive_excl_count=0
        drive_dup_count=0
        while IFS=$'\t' read -r tag fpath; do
            [[ -n "$tag" ]] || continue
            case "$tag" in
                EXCLUDE)
                    printf '%s' "$fpath" | grep -qiE "$allowed_re" || continue
                    [[ -e "$destination/$fpath" ]] && continue   # leftover on disk -> indexed
                    drive_excl_count=$((drive_excl_count + 1)) ;;
                DUP)
                    printf '%s' "$fpath" | grep -qiE "$allowed_re" || continue
                    drive_dup_count=$((drive_dup_count + 1)) ;;
            esac
        done <<<"$parsed"
    else
        drive_excl_count=0
        drive_dup_count=0
    fi
}

# Render the per-drive remote/local/dups/allowed/excluded/indexable table to stdout.
# Called inside the report's { } block (output goes to the report file) and again
# after (to the terminal). Globals: drive_rows (name<TAB>remote<TAB>local
# <TAB>dups<TAB>allowed<TAB>excluded<TAB>indexable per completed drive),
# total_remote, total_local, total_dups, total_allowed, total_excl,
# total_indexable.
#
# Column order follows the pipeline: rclone applies the dup filter on the source
# BEFORE the documents-only allowlist is applied, so `dups` precedes `allowed`.
# `indexable` is the FINAL rightmost number (the KB count). The arithmetic is
# exact per row and for TOTAL:
#     allowed - excluded - dups = indexable
# `excluded` and `dups` count ONLY allowed-typed files (excluded: truly removed,
# not leftovers on disk); non-allowed-typed rclone excludes (.py/.csv/.sv/...)
# do not affect the indexable count and appear only in the report body's
# "Files excluded" section.
print_drive_table() {
    printf 'Drive table:\n'
    printf '%-28s %10s %10s %8s %10s %10s %10s\n' "DRIVE" "remote" "local" "dups" "allowed" "excluded" "indexable"
    printf '%-28s %10s %10s %8s %10s %10s %10s\n' "-----" "------" "-----" "----" "-------" "--------" "---------"
    if [[ -n "$drive_rows" ]]; then
        while IFS=$'\t' read -r dname rem loc dup alw exc idx; do
            [[ -n "$dname" ]] || continue
            printf '%-28s %10s %10s %8s %10s %10s %10s\n' "$dname" "$rem" "$loc" "$dup" "$alw" "$exc" "$idx"
        done <<<"$drive_rows"
    fi
    printf '%-28s %10s %10s %8s %10s %10s %10s\n' "TOTAL" "$total_remote" "$total_local" "$total_dups" "$total_allowed" "$total_excl" "$total_indexable"
    printf 'allowed - excluded - dups = indexable  (excluded/dups: allowed-typed, truly-removed only; full rclone excludes in body)\n'
}

# Write the sync report (header + $summary + drive table + "Files changed"
# COPY/UPDATE/DELETE + "Files excluded" + "Files not downloaded") and exit with
# $1. Called both on fail-fast (mid-loop) and at success. $changes holds
# TAG<TAB><drive>/<path>[<TAB><reason>] lines accumulated per drive by
# parse_drive_log.
write_report_and_exit() {
    local exit_code=$1 copy_n update_n delete_n fail_n exclude_n dup_n
    normalize_perms
    copy_n=$(awk -F'\t' '$1=="COPY"' <<<"$changes" | wc -l)
    update_n=$(awk -F'\t' '$1=="UPDATE"' <<<"$changes" | wc -l)
    delete_n=$(awk -F'\t' '$1=="DELETE"' <<<"$changes" | wc -l)
    fail_n=$(awk -F'\t' '$1=="FAIL"' <<<"$changes" | wc -l)
    exclude_n=$(awk -F'\t' '$1=="EXCLUDE"' <<<"$changes" | wc -l)
    dup_n=$(awk -F'\t' '$1=="DUP"' <<<"$changes" | wc -l)
    {
        printf 'gdrive sync report\n'
        printf 'remote: %s\n' "$remote"
        printf 'destination: %s\n' "$destination"
        printf 'started (UTC): %s\n' "$ts"
        printf 'backup-dir: %s\n' "$backup_root"
        printf 'dry-run: %s\n\n' "$([ "$dry_run" = 1 ] && echo yes || echo no)"
        printf '%s\n' "$summary"
        print_drive_table
        printf '\n'
        printf 'Files changed: %d COPY, %d UPDATE, %d DELETE\n' "$copy_n" "$update_n" "$delete_n"
        if (( copy_n > 0 )); then
            printf 'COPY (%d):\n' "$copy_n"
            awk -F'\t' '$1=="COPY"{print "  COPY    "$2}' <<<"$changes"
        fi
        if (( update_n > 0 )); then
            printf 'UPDATE (%d):\n' "$update_n"
            awk -F'\t' '$1=="UPDATE"{print "  UPDATE  "$2}' <<<"$changes"
        fi
        if (( delete_n > 0 )); then
            printf 'DELETE (%d):\n' "$delete_n"
            awk -F'\t' '$1=="DELETE"{print "  DELETE  "$2}' <<<"$changes"
        fi
        printf '\nFiles excluded: %d  (ALL rclone excludes, every type; only the allowed-typed, truly-removed subset feeds the table `excluded` column)\n' "$exclude_n"
        if (( exclude_n > 0 )); then
            awk -F'\t' '$1=="EXCLUDE"{print "  "$2}' <<<"$changes"
        else
            printf '  (none)\n'
        fi
        printf '\nDuplicates ignored: %d\n' "$dup_n"
        if (( dup_n > 0 )); then
            awk -F'\t' '$1=="DUP"{print "  "$2}' <<<"$changes"
        else
            printf '  (none)\n'
        fi
        printf '\nFiles not downloaded: %d\n' "$fail_n"
        if (( fail_n > 0 )); then
            awk -F'\t' '$1=="FAIL"{print "  "$2" — "$3}' <<<"$changes"
        else
            printf '  (none)\n'
        fi
    } > "$report"
    chmod 600 -- "$report" 2>/dev/null || true   # owner-only (umask 022 would make it 0644)
    emit "Files changed: ${copy_n} COPY, ${update_n} UPDATE, ${delete_n} DELETE; excluded: ${exclude_n}; duplicates: ${dup_n}; not downloaded: ${fail_n} (see report)"
    print_drive_table
    printf 'Report written: %s\n' "$report" >&2
    exit "$exit_code"
}

changes=""
processed_drives=0
# Per-drive accumulators for the report's drive table + totals. remote/local/
# allowed/indexable/excluded are summed per drive; drive_rows holds one TSV row
# per completed drive (name<TAB>remote<TAB>local<TAB>allowed<TAB>indexable<TAB>excluded<TAB>dups)
# rendered as the report table.
total_remote=0
total_local=0
total_allowed=0
total_indexable=0
total_bytes=0
total_excl=0     # init here: print_drive_table() reaches these on the fail-fast /
total_dups=0     # empty-source paths INSIDE the loop, before the post-loop compute
drive_rows=""
declare -A seen_names=()   # safe_name -> drive_id, for the name-collision guard

while IFS=$'\t' read -r drive_id drive_name; do
    [[ -n "$drive_id" && -n "$drive_name" ]] || continue

    # Drive names can contain path separators. Keep them as safe local names.
    safe_name=$(printf '%s' "$drive_name" | tr '/\\:' '___' | tr -d '\000-\037')
    safe_name=$(sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' <<<"$safe_name")
    [[ -n "$safe_name" ]] || safe_name="$drive_id"

    # --- name-collision guard ------------------------------------------------
    # Two drives can map to the same safe local name (same Drive name, or a
    # sanitization collision like "A:B" -> "A_B" == "A_B"). Both would sync into
    # the same dir + backup subtree; the second sync would delete the first
    # drive's files (sync deletes to match source). Abort before any sync.
    if [[ -n "${seen_names[$safe_name]:-}" && "${seen_names[$safe_name]}" != "$drive_id" ]]; then
        printf 'FAIL: drive %s (id %s) maps to local name "%s" already used by drive id %s — aborting (name collision would cause data loss).\n' "$drive_name" "$drive_id" "$safe_name" "${seen_names[$safe_name]}" >&2
        emit "FAIL: drive ${drive_name} collides on local name ${safe_name} — aborted (data-loss guard)"
        write_report_and_exit 1
    fi
    seen_names[$safe_name]=$drive_id

    target="$destination/$safe_name"
    printf 'Syncing shared drive %s -> %s\n' "$drive_name" "$target"
    processed_drives=$((processed_drives + 1))

    # --- hard guard: refuse to sync an empty remote drive --------------------
    # rclone sync deletes to match the source, so an empty remote (bad mount,
    # revoked access, transient API return) would mass-delete the local drive
    # dir. The account-wide "no drives visible" case is already caught above
    # (drive_count==0); this catches a SINGLE drive coming back empty. Recursive
    # listing is required — depth-1 would miss files in subdirs and false-abort.
    # Keep the full listing (not just wc -l): remote_files counts every Drive
    # file; remote_allowed counts those matching the indexable allowlist ext
    # (pre-exclusion, via allowed_re) — the "allowed" column. $() strips the
    # trailing newline rclone emits, so guard the empty case before wc -l.
    if ! remote_listing=$(rclone lsf -R --files-only "${remote}:" --drive-team-drive "$drive_id" 2>/dev/null); then
        printf 'FAIL: cannot list remote files for drive %s (rclone lsf error) — aborting (fail-fast).\n' "$drive_name" >&2
        emit "FAIL: cannot list remote files for drive ${drive_name} — aborted (fail-fast)"
        write_report_and_exit 1
    fi
    if [[ -z "$remote_listing" ]]; then
        remote_files=0
        remote_allowed=0
    else
        remote_files=$(wc -l <<<"$remote_listing")
        remote_allowed=$(grep -cEi "$allowed_re" <<<"$remote_listing" || true)
    fi
    if (( remote_files == 0 )); then
        printf 'FAIL: shared drive %s has 0 remote files — refusing to sync (empty source would mass-delete %s). Investigate Drive access; local copy preserved.\n' "$drive_name" "$target" >&2
        emit "FAIL: drive ${drive_name} has 0 remote files — aborted (fail-fast, empty-source guard)"
        write_report_and_exit 1
    fi

    # --- allowed list (.kb-ignore ancestor-chain filter) ---------------------
    # The shared gitignore-style matcher (scripts/kb_ignore.py) reads .kb-ignore
    # at ./root and along each path's ancestor chain: ./root/.kb-ignore (globals),
    # ./root/gdrive/.kb-ignore, ./root/gdrive/<safe_name>/.kb-ignore, + nested
    # dirs. rclone lsf paths are drive-relative; prefix gdrive/<safe_name>/ so the
    # matcher sees the same ./root-relative paths the gateway index walk does
    # (download + index stages honor the SAME .kb-ignore rules). The filter drops
    # denied files + resolves `!` negation natively -- no rclone-glob translation,
    # no `!`-stripping. No-op when no .kb-ignore exists (every path allowed).
    tmp_filesfrom=$(mktemp); temp_files+=("$tmp_filesfrom")
    if ! awk -v p="gdrive/$safe_name/" '{print p $0}' <<<"$remote_listing" \
        | python3 ./scripts/kb_ignore.py filter --root ./root \
        | awk -v p="gdrive/$safe_name/" 'index($0,p)==1{print substr($0,length(p)+1)}' \
        > "$tmp_filesfrom"; then
        rm -f "$tmp_filesfrom"; tmp_filesfrom=""
        emit "FAIL: .kb-ignore filter failed for drive ${drive_name} -- aborted (fail-fast)"
        write_report_and_exit 1
    fi

    # Per-drive rclone log: parsed right after the copy for COPY/UPDATE (paths
    # are drive-relative, so the drive name is added at parse time). DELETE is
    # NOT in the log -- rclone copy does not delete; the deletion reconcile
    # below owns DELETE. EXCLUDE is NOT in the log either -- denied files are
    # dropped by the filter before rclone; the denied-block below owns EXCLUDE.
    # DEBUG (a superset of INFO) so the COPY/UPDATE/FAIL lines appear. Temp; the
    # EXIT trap removes it.
    drive_log=$(mktemp); temp_files+=("$drive_log")
    log_args=(--log-level DEBUG --log-file "$drive_log")

    rclone_args=(
        copy
        "${remote}:"
        "$target"
        --drive-team-drive "$drive_id"
        --files-from "$tmp_filesfrom"
        # Per-drive subdir: --backup-dir preserves hierarchy relative to each
        # copy's destination root ($target), NOT including the drive name, so
        # without this two drives sharing a relative path would collide in the
        # same backup_root/<subpath>. Overwritten files are moved here first;
        # the deletion reconcile below also moves removed-from-Drive files here.
        --backup-dir "$backup_root/$safe_name"
        "${log_args[@]}"
    )
    ((dry_run)) && rclone_args+=(--dry-run)

    # --- fail-fast: any transfer error aborts the whole run ------------------
    # Known non-downloadable files are dropped by the .kb-ignore filter above, so
    # a non-zero exit here is a genuine failure (new protected file, network
    # error, ...) — do NOT continue to the next drive. The report is still
    # written with the failures. When the filter denies every remote file,
    # tmp_filesfrom is empty: skip rclone (copy would be a no-op) and parse the
    # empty log (0 changes); the denied-block + reconcile still run.
    if [[ -s "$tmp_filesfrom" ]] && ! rclone "${rclone_args[@]}"; then
        printf 'FAIL: shared drive %s had transfer errors — aborting (fail-fast). See report for failing files; add new non-downloadable paths to a .kb-ignore under ./root/gdrive/%s/.\n' "$drive_name" "$safe_name" >&2
        emit "FAIL: drive ${drive_name} had transfer errors — aborted (fail-fast)"
        parse_drive_log
        write_report_and_exit 1
    fi

    parse_drive_log

    # --- .kb-ignore denied files (replaces rclone --exclude-from "Excluded") --
    # The filter dropped denied files BEFORE rclone, so the copy log has no
    # "Excluded" lines. Re-derive the denied set (remote_listing - allowed) and
    # emit EXCLUDE tags for the report body. drive_excl_count = the allowed-typed
    # (indexable-ext) subset NOT left on disk (denied-on-disk files are counted
    # by find drive_indexable below, but the gateway also denies them -> known
    # table imprecision, same as the old --exclude-from path).
    remote_sorted=$(LC_ALL=C sort -u <<<"$remote_listing")
    allowed_sorted=$(LC_ALL=C sort -u <"$tmp_filesfrom")
    denied_listing=$(LC_ALL=C comm -23 <(printf '%s\n' "$remote_sorted") <(printf '%s\n' "$allowed_sorted"))
    drive_excl_count=0
    while IFS= read -r rel; do
        [[ -z "$rel" ]] && continue
        changes+=$'EXCLUDE\t'"$safe_name/$rel"$'\n'
        printf '%s' "$rel" | grep -qiE "$allowed_re" || continue
        [[ -e "$target/$rel" ]] && continue   # leftover on disk -> not subtracted
        drive_excl_count=$((drive_excl_count + 1))
    done <<<"$denied_listing"

    # --- deletion reconcile (rclone copy does not delete; we own it) ----------
    # A local file NOT in remote_listing was removed from Drive. Back it up to
    # backup_root unless PROTECTED: a dot-name (find -not -name '.*' drops them),
    # a .sync-reports file (-not -path drops them), or a file DENIED by .kb-ignore
    # (denied files persist locally -- same as the old sync --exclude-from, which
    # neither copied nor deleted excluded files). Replicates `sync --delete-after`
    # (no --delete-excluded): removed-from-Drive + allowed -> backup; denied ->
    # keep. Under --dry-run the would-be DELETE set is still emitted (no moves),
    # so the dry-run report shows what WOULD be deleted.
    if [[ -d "$target" ]]; then
        local_listing=$(find "$target" -type f \
            -not -path '*/.sync-reports/*' \
            -not -name '.*' \
            -printf '%P\n' | LC_ALL=C sort -u)
        if [[ -n "$local_listing" ]]; then
            local_only=$(LC_ALL=C comm -23 \
                <(printf '%s\n' "$local_listing") \
                <(printf '%s\n' "$remote_sorted"))
            if [[ -n "$local_only" ]]; then
                # Batch-check denied (protected) via one matcher pass: prefix +
                # filter -> the OUTPUT is the allowed (not-protected) subset ->
                # those get backed up. Denied (in input, absent from output) ->
                # keep. Same prefix/strip convention as the main filter above.
                if ! allowed_local_only=$(awk -v p="gdrive/$safe_name/" '{print p $0}' <<<"$local_only" \
                    | python3 ./scripts/kb_ignore.py filter --root ./root \
                    | awk -v p="gdrive/$safe_name/" 'index($0,p)==1{print substr($0,length(p)+1)}'); then
                    emit "FAIL: .kb-ignore filter failed in reconcile for drive ${drive_name} -- aborted (fail-fast)"
                    write_report_and_exit 1
                fi
                while IFS= read -r rel; do
                    [[ -z "$rel" ]] && continue
                    if (( ! dry_run )); then
                        mkdir -p "$backup_root/$safe_name/$(dirname "$rel")"
                        mv -- "$target/$rel" "$backup_root/$safe_name/$rel"
                    fi
                    changes+=$'DELETE\t'"$safe_name/$rel"$'\n'
                done <<<"$allowed_local_only"
            fi
        fi
    fi

    drive_files=0
    drive_indexable=0
    drive_bytes=0
    if [[ -d "$target" ]]; then
        drive_files=$(find "$target" -type f -printf '.' | wc -c)
        drive_indexable=$(find "$target" -type f "${indexable_filter[@]}" -printf '.' | wc -c)
        drive_bytes=$(du -sb -- "$target" | awk '{print $1}')
    fi
    drive_mb=$(awk -v bytes="$drive_bytes" 'BEGIN { printf "%.2f", bytes / 1000000 }')
    printf 'Drive report: %s -> %s: %s remote, %s local, %s dups, %s allowed, %s excluded, %s indexable (%s MB local)\n' \
        "$drive_name" "$safe_name" "$remote_files" "$drive_files" "$drive_dup_count" "$remote_allowed" "$drive_excl_count" "$drive_indexable" "$drive_mb"
    total_remote=$((total_remote + remote_files))
    total_local=$((total_local + drive_files))
    total_allowed=$((total_allowed + remote_allowed))
    total_indexable=$((total_indexable + drive_indexable))
    total_excl=$((total_excl + drive_excl_count))
    total_dups=$((total_dups + drive_dup_count))
    total_bytes=$((total_bytes + drive_bytes))
    # printf -v (not $(printf...)) preserves the trailing newline — command
    # substitution would strip it and concatenate the rows.
    # TSV order: name, remote, local, dups, allowed, excluded, indexable
    # (dups before allowed — rclone applies the dup filter on the source before
    # the allowlist; indexable is the final rightmost KB count).
    printf -v __row '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$drive_name" "$remote_files" "$drive_files" "$drive_dup_count" "$remote_allowed" "$drive_excl_count" "$drive_indexable"
    drive_rows+="$__row"
done < <(jq -r '.[] | [.id, .name] | @tsv' <<<"$drive_json")

# Totals from the per-drive accumulators (NOT a fresh find/du on $destination —
# that would double-count .sync-reports/*.report files at the destination root
# and, with the old -exec form, count path-name BYTES instead of files).
# total_excl / total_dups are the ALLOWED-TYPED subsets accumulated in the loop
# (excluded: truly removed, not leftovers on disk), so the table arithmetic
# holds: total_allowed - total_excl - total_dups = total_indexable. The FULL
# rclone EXCLUDE/DUP counts (all types) are in the report body.
total_mb=$(awk -v bytes="$total_bytes" 'BEGIN { printf "%.2f", bytes / 1000000 }')
emit "Sync report: ${processed_drives} drives, ${total_remote} remote, ${total_local} local, ${total_dups} dups, ${total_allowed} allowed, ${total_excl} excluded, ${total_indexable} indexable, ${total_mb} MB local"

# Deleted/overwritten files rclone moved into --backup-dir (recovery net). Empty
# when nothing changed or under --dry-run (sync does not move files then).
backed_up=0
if (( !dry_run )) && [[ -d "$backup_root" ]]; then
    backed_up=$(find "$backup_root" -type f | wc -l)
fi
emit "Files backed up (deleted/overwritten): ${backed_up} (in ${backup_root})"

# --- index chain: reconcile the synced tree into the OWUI KB via api-gateway ---
# Stateless: the gateway walks ./root/gdrive (ro mount, dir=gdrive), drives OWUI
# sync/diff against the live KB, uploads new/changed files (the OWUI per-upload
# background task is the sole linker: extract -> embed -> link), cleans up removed
# ones, and re-triggers failed files (delete + re-upload so a fresh background task
# is queued). Default incremental; --index-all drains + re-uploads everything;
# --retry-pending also re-triggers files still pending (stalled in OCR). Fail-fast
# on a non-2xx response or ok=false. The gdrive KB is resolved BY NAME (the gateway
# is stateless; no GDRIVE_KB_ID env). Skipped under --dry-run or if the gdrive KB
# cannot be resolved (run: make kb-bootstrap KB=gdrive).
if (( !dry_run )); then
    set -a; . ./.env 2>/dev/null || true; . ./.env.local 2>/dev/null || true; set +a
    if [[ -n "${OPENWEBUI_ADMIN_API_KEY:-}" ]]; then
        if [[ -z "${KB_HOST:-}" ]]; then
            echo "FAIL  KB_HOST not set -- export KB_HOST=http://<host>:<port> (see .env.template)" >&2
            exit 1
        fi
        O="${KB_HOST%/}"
        # Resolve the "gdrive" KB by name (paginated, unique-or-fail). The gateway
        # holds the admin key but takes kb_id, so resolve here and pass it through.
        if ! KB_ID=$(KB=gdrive ./scripts/kb-bootstrap.sh --resolve 2>/dev/null); then
            emit "FAIL: could not resolve the 'gdrive' KB by name (0 or >1 match). Run: make kb-bootstrap KB=gdrive ; then retry. Diagnose: KB=gdrive ./scripts/kb-bootstrap.sh --resolve"
            write_report_and_exit 1
        fi
        # --- in-flight drain guard (client-side): refuse to POST /index if a gdrive
        #     drain is already running for this KB. A drain is in flight when OWUI
        #     still has un-finished files (pending+processing > 0); re-dispatching
        #     then races the per-file extract->embed->link (markitdown-ocr) + the
        #     gateway sync/diff, and --index-all would delete the in-flight files.
        #     --retry-pending is EXEMPT (it intentionally re-triggers pending files).
        #     Strict + fail-closed: curl -f fails on HTTP 401/503/etc (a gateway
        #     error body is valid JSON {"error":..} WITHOUT pending/processing, so a
        #     plain .get(,0) would parse it as 0 -> unsafe proceed); --max-time bounds
        #     the paginating scan; missing/invalid pending/processing -> refuse.
        #     CLIENT-SIDE guard: bypassable by raw curl / make kb-index; has a
        #     check-then-dispatch TOCTOU; the /status scan caps at 10k files
        #     (owui.py page-200), so a pending file beyond that is missed.
        if (( ! retry_pending )); then
            if ! status_resp=$(curl -fsS --max-time 1200 \
                    "${O}/status?kb_id=${KB_ID}&dir=gdrive&json=1" \
                    -H "Authorization: Bearer ${OPENWEBUI_ADMIN_API_KEY}" 2>/dev/null); then
                emit "FAIL: could not read /status (gateway error/unreachable/timeout) for KB ${KB_ID}; refusing to dispatch (cannot confirm no drain in flight). Check: ${O}/health ; make kb-status KB=gdrive"
                write_report_and_exit 1
            fi
            inflight=$(printf '%s' "$status_resp" | python3 -c '
import sys, json
try:
    d = json.load(sys.stdin)
    p, q = d["pending"], d["processing"]   # KeyError if absent -> fail-closed
    if not (isinstance(p, int) and isinstance(q, int) and p >= 0 and q >= 0):
        raise ValueError
    print(p + q)
except Exception:
    print("ERR")
')
            if [[ "$inflight" == "ERR" ]]; then
                emit "FAIL: /status response for KB ${KB_ID} missing/invalid pending or processing (got: ${status_resp:0:120}); refusing to dispatch (cannot confirm no drain in flight)"
                write_report_and_exit 1
            fi
            if (( inflight > 0 )); then
                emit "FAIL: a gdrive drain is in flight for KB ${KB_ID} (pending+processing=${inflight}). Refusing to re-dispatch (would race the in-flight extract->embed->link). Wait for terminal: make kb-status KB=gdrive ; make gdrive-sync-finalize (polls then REINDEXes). Or retry stalled pending: make gdrive-sync RETRY_PENDING=1"
                write_report_and_exit 1
            fi
        fi
        idx_q="kb_id=${KB_ID}&dir=gdrive"
        (( index_all )) && idx_q="${idx_q}&reindex_all=1"
        (( retry_pending )) && idx_q="${idx_q}&retry_pending=1"
        if [[ -n "${path}" ]]; then
            # URL-encode the subpath (gdrive paths may contain spaces) before
            # appending it to the query string.
            path_enc=$(python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1],safe=""))' "$path")
            idx_q="${idx_q}&path=${path_enc}"
        fi
        if (( index_all )); then
            emit "Indexing synced tree into OWUI KB (via api-gateway /index, full re-index)..."
        else
            emit "Indexing synced tree into OWUI KB (via api-gateway /index, incremental)..."
        fi
        # shellcheck disable=SC2086 # idx_q is a single query string, intentionally unquoted
        if ! idx_resp=$(curl -sS --max-time 1200 -X POST \
                -H "Authorization: Bearer ${OPENWEBUI_ADMIN_API_KEY}" \
                -H "Content-Type: application/json" -d '{}' \
                "${O}/index?${idx_q}" 2>&1); then
            emit "FAIL: kb /index call failed (curl error): ${idx_resp}"
            write_report_and_exit 1
        fi
        # Parse the JSON response (jq is a declared dependency above). jq -e
        # sets exit status from the last value's truthiness; it prints the
        # boolean TEXT (true/false) to stdout, so use the exit status, not
        # stdout, to decide JSON-ness (comparing stdout to "1" is always false).
        if ! printf '%s' "$idx_resp" | jq -e 'has("ok")' >/dev/null 2>&1; then
            emit "FAIL: kb /index returned a non-JSON/error response: ${idx_resp}"
            write_report_and_exit 1
        fi
        idx_added=$(printf '%s' "$idx_resp" | jq -r '.added')
        idx_modified=$(printf '%s' "$idx_resp" | jq -r '.modified')
        idx_deleted=$(printf '%s' "$idx_resp" | jq -r '.deleted')
        idx_unmodified=$(printf '%s' "$idx_resp" | jq -r '.unmodified')
        idx_retried=$(printf '%s' "$idx_resp" | jq -r '.retried // 0')
        idx_ok=$(printf '%s' "$idx_resp" | jq -r '.ok')
        idx_errn=$(printf '%s' "$idx_resp" | jq -r '(.errors // []) | length')
        idx_errn=${idx_errn:-0}
        emit "KB index: added=${idx_added} modified=${idx_modified} deleted=${idx_deleted} unmodified=${idx_unmodified} retried=${idx_retried} errors=${idx_errn}"
        if (( idx_errn > 0 )); then
            printf 'KB index per-file errors:\n' >&2
            printf '%s' "$idx_resp" | jq -r '.errors[] | "  \(.filename // .file_id // "?"): \(.status) — \(.error // "")"' >&2
        fi
        if [[ "$idx_ok" != "true" ]]; then
            emit "FAIL: kb /index completed with errors (ok=false) — see per-file errors above"
            write_report_and_exit 1
        fi
    else
        printf 'OPENWEBUI_ADMIN_API_KEY unset — skipping kb index (run: make api-keys)\n' >&2
    fi
fi

write_report_and_exit 0