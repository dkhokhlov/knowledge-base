# Copy to .env.local (gitignored). `make bootstrap` copies this file and
# generates BOTH secrets (random) if left empty, then chmods .env.local to 0600.
# You do not normally edit these by hand.

# Open WebUI JWT signing key. Generated by `make bootstrap`. Do not change it
# after users exist, or all sessions are invalidated.
WEBUI_SECRET_KEY=

# Shared bearer token that gates the Graphiti MCP HTTP endpoint (one token for
# all users). Generated by `make bootstrap` and printed to the terminal; copy it
# into your MCP clients as Authorization: Bearer <this value>.
GRAPHITI_API_TOKEN=