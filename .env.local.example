# Copy to .env.local (gitignored) and fill in BOTH before `make start`.
# `make bootstrap` copies this file; it does NOT generate these values.

# Open WebUI JWT signing key. `make bootstrap` fills this with a random value
# if left empty (the user never types it). Stable across restarts once set.
WEBUI_SECRET_KEY=

# Shared bearer token that gates the Graphiti MCP HTTP endpoint (one token for
# all users). YOU choose this value and configure your MCP clients to send
# Authorization: Bearer <this value>. Must be non-empty. Not auto-generated.
GRAPHITI_API_TOKEN=