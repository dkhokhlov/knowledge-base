# Copy to .env.local (gitignored). `make bootstrap` copies this file and
# generates WEBUI_SECRET_KEY (random) if left empty, then chmods .env.local to
# 0600. You do not normally edit these by hand.

# Open WebUI JWT signing key. Generated by `make bootstrap`. Do not change it
# after users exist, or all sessions are invalidated.
WEBUI_SECRET_KEY=

# Agents authenticate with KB_API_KEY (an Open WebUI per-account key). The
# admin's KB_API_KEY is the OPENWEBUI_ADMIN_API_KEY below; per-account
# KB_API_KEYs are issued by the api-gateway admin endpoint (POST /admin/users)
# and relayed to each account.

# ---- First (admin) account credentials (used by `make admin-signup`, `make
# api-keys`, and `make test`).
# Generated by `make bootstrap`: OPENWEBUI_FIRST_USER=admin@${KB_DOMAIN}
# (KB_DOMAIN is in .env, default local.test; overridable via `make bootstrap
# KB_DOMAIN=<domain>`) + a random OPENWEBUI_FIRST_PASSWORD.
# Edit .env.local to override either (e.g. set your own password). Tests sign in
# with these to obtain a JWT. `make clean-all && make bootstrap` recomputes the
# email + a fresh password for a new KB_DOMAIN.
OPENWEBUI_FIRST_USER=
OPENWEBUI_FIRST_PASSWORD=

# ---- markitdown-ocr service token (SECRET). Generated by `make bootstrap`
# when OCR_ENABLED=true (in .env, default true). The sidecar authenticates
# /process with it; OWUI's external-extraction API key is set to it by `make
# api-keys`. Absent when OCR_ENABLED=false. Do not commit.
OCR_SERVICE_TOKEN=

# ---- Admin API key. Populated by `make api-keys` (run after `make start` and
# the admin has registered). Leave empty here. The admin key grants full admin
# (bypasses access control) -- it must NOT be given to agents. Operator + test
# user keys (KB_API_KEY) are NOT stored here: the operator's own key lives in
# ~/.api_keys (set via `make users-create EMAIL=...`); the throwaway test user's
# key is written to the iso-clone .env.local by the e2e harness. Set FORCE=1
# when running `make api-keys` to rotate (replace) the admin key.
OPENWEBUI_ADMIN_API_KEY=