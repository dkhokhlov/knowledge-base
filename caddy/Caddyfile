# Public edge for the kb-gateway. Caddy proxies every path to the gateway,
# which enforces KB_API_KEY auth (validated against Open WebUI) and authorizes
# per call. /health is ungated by the gateway (for probes). graphiti-mcp +
# neo4j are not reachable from here (they are on the internal graph_internal
# network, bridged only by kb-gateway).
:8000 {
	reverse_proxy kb-gateway:8010
}