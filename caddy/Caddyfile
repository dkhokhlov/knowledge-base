# Public edge for the KnowledgeBase stack (single external URL = KB_HOST).
# Caddy listens on :3000 (container port = host port; no translation).
# Routing:
#   /memory/*          -> api-gateway:8010  (memory/facts; gateway serves /memory/*)
#   POST /admin/users  -> api-gateway:8010  (admin user provisioning; POST only)
#   POST /index        -> api-gateway:8010  (gdrive index sync drive; admin only)
#   POST /retrieve     -> api-gateway:8010  (KB retrieval; hybrid/lexical/vector)
#   GET  /status       -> api-gateway:8010  (gdrive index status; read)
#   GET  /openapi.json -> api-gateway:8010  (gateway surface; ungated)
#   /health            -> api-gateway:8010  (aggregated; probes OWUI; ungated)
#   /* (catch-all)     -> openwebui:8080   (OWUI landing + /api/* + SPA)
# GET /admin/users falls through to OWUI (SPA admin view) — only POST is the
# gateway's provisioning endpoint, so browser deep-links keep working.
# /index + /status are method-scoped so a browser GET /index falls through to
# OWUI (no SPA route claims it). The /index request body is a tiny trigger;
# file bytes flow gateway -> OWUI internally (not through Caddy).
# graphiti + neo4j are not reachable from here (graph_internal, bridged only
# by api-gateway). OWUI is reached over owui_net (Caddy joins owui_net + edge).
:3000 {
	@provision {
		method POST
		path /admin/users
	}
	@index {
		method POST
		path /index
	}
	@status {
		method GET
		path /status
	}
	@openapi {
		method GET
		path /openapi.json
	}
	@retrieve {
		method POST
		path /retrieve
	}
	handle /memory/* {
		reverse_proxy api-gateway:8010
	}
	handle @provision {
		reverse_proxy api-gateway:8010
	}
	handle @index {
		reverse_proxy api-gateway:8010
	}
	handle @status {
		reverse_proxy api-gateway:8010
	}
	handle @openapi {
		reverse_proxy api-gateway:8010
	}
	handle @retrieve {
		reverse_proxy api-gateway:8010
	}
	handle /health {
		reverse_proxy api-gateway:8010
	}
	handle {
		reverse_proxy openwebui:8080
	}
}
